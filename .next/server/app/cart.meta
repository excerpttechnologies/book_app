{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(user)/layout,_N_T_/(user)/cart/layout,_N_T_/(user)/cart/page,_N_T_/cart"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KHVzZXIp/cart/__PAGE__",
    "/!KHVzZXIp/cart",
    "/!KHVzZXIp",
    "/_index",
    "/_head"
  ]
}